            <ab type="page-feature" subtype="manuscript-annotation">
              <label>前襯鉛筆字上</label>
              <seg type="diplomatic-text" rend="unknown">490.9／Sh-1</seg>
            </ab>
            <ab type="page-feature" subtype="manuscript-annotation">
